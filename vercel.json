{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "swiftgrowthdigital.com"
        }
      ],
      "destination": "https://www.swiftgrowthdigital.com/$1",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/api/webhooks/whatsapp",
      "destination": "https://oyrpeyjogtpbtbdvcjgs.supabase.co/functions/v1/whatsapp-webhook"
    },
    {
      "source": "/api/whatsapp/media/:path*",
      "destination": "https://oyrpeyjogtpbtbdvcjgs.supabase.co/functions/v1/whatsapp-media/:path*"
    },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html" },
    { "source": "/data-deletion", "destination": "/data-deletion.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/contact", "destination": "/contact.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
